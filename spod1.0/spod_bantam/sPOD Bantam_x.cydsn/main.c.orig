void write_millis(void)
{
    uint32_t ms = millis();
    
    myPrintf("(");
    
    if(ms/3600000)
    myPrintf("%d:",(ms/3600000));
    
    ms = ms % 3600000;
    
    if(ms/60000)
    myPrintf("%d:",(ms/60000));
    
    ms = ms % 60000;
    
    if(ms/10000 == 0)
    myPrintf("0");
    
    myPrintf("%d.",(ms/1000));
    
    ms = ms % 1000;
    
    if(ms/100 == 0)
    myPrintf("0");
    
    if(ms/10 == 0)
    myPrintf("0");
    
    myPrintf("%d)\n",ms);
    
}

