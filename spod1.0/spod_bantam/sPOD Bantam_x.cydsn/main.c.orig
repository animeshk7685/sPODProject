uint8_t localEeprom[CY_FLASH_SIZEOF_ROW] = {0};
uint8_t *localEeprom_uint8 = (uint8_t *)localEeprom;
uint16_t *localEeprom_uint16 = (uint16_t *)localEeprom;
uint32_t *localEeprom_uint32 = (uint32_t *)localEeprom;
 
void writeFlash(void)
{
//    for(unsigned int i = 0 ; i < sizeof(passkey) ; i++)
//    {
//        localEeprom[PASSKEY_OFFSET + i] = passkey >> (8 * (3 - i)) & 0xff;
////        localEeprom[PASSKEY_OFFSET + i] = passkey >> (8 * i) & 0xff;
//    }
    
//    localEeprom[PASSKEY_OFFSET/2] = passkey >> 16 & 0xff;
//    localEeprom[PASSKEY_OFFSET/2 + 1] = passkey & 0xff;
    
    localEeprom_uint32[PASSKEY_OFFSET/4] = passkey;
    
    localEeprom_uint8[PASS_INIT_OFFSET] = passkey_init;
    
    localEeprom_uint8[PRO_MODE_OFFSET] = status.pro.isEnabled ? 1 : 0;
    
    if(status.pro.isEnabled)
    {   
        localEeprom_uint8[PRO_WRITABLE_OFFSET] = status.pro.isWritable ? 1 : 0;
        localEeprom_uint8[PRO_SLEEPDISABLED_OFFSET] = status.pro.isDisableSleep ? 1 : 0;
        
        for(unsigned int i = 0 ; i < 8 ; i++)
        {
            localEeprom_uint8[PRO_ALWAYSON_OFFSET + i] = status.pro.alwaysOn[i];
            localEeprom_uint8[PRO_LASTSWVAL_OFFSET + i] = status.pro.lastSwVal[i];
            
            localEeprom_uint16[PRO_TIMERS_OFFSET/2 + i] = status.pro.timers[i];
        }
    }
    
    CySysFlashWriteRow(EEPROM_FLASH_ADDR_ROW, (const unsigned char *) localEeprom);
}



double approxRollingAverage (double avg, double new_sample, double window) {
		double sub = avg / window;
		double add = new_sample / window;
	
		//printf("%f, %f\n", sub,  add);
	
    avg = avg - sub;
    avg = avg + add;

    return avg;
}

uint32 offTimer[8] = {0};

uint32 debugOnTimer = 0;

PT_THREAD(readInputs(struct state *s))             
{
    static adcVals localCur;
    static uint16 read;
    static uint8 faults, newVal, lastVal;
    static int i, j;
    static double avgCurrentsDec[8];
    static double avgCurrentsHex[8];
    static uint32_t proShortTimer[8] = {0};
    
    static uint8 avgF = 3;
//    static uint32 shortTimeout[8];
    
    static uint8_t debugCycle = 0;
    static bool passDebug = true;
    static bool outOn = false;
    
    static bool rstDebFlsh = false;
    
    PT_BEGIN(&s->pt);
    while(1)                // 
    {        
        timer_set(&s->timer, 5);
        PT_WAIT_UNTIL(&s->pt, timer_expired(&s->timer));
        
        
        read = (uint16_t)read_inputs(0); 
        
        status.debug = read & DEBUG_MASK;
        
        
        
        if((debugCycle % 2) != status.debug)
        {
            debugCycle++;
            
            if(status.debug) {
                debugOnTimer = millis();
                passkeyTimer = millis();        // reset on rising edge of debug switch
//                writePassKey(passkey);
                
                rstDebFlsh = true;
            }
            else if(rstDebFlsh)
            {
                canErr.rebootCnt = 1;
                canErr.wdtCnt = 0;
                canErr.canErrCnt = 0;
                canErr.canRstCnt = 0;
                
                canErr.canErrMore = 0;
                canErr.canRstMore = 0;
                canErr.canRstTryCnt = 0;
    
            }
        }
        
        if(passDebug)
        {  
            if(debugCycle > 3) {
                generatePasskey();              // only regenerate if switch it tripped 4 times in the first 30s
                passDebug = false; 
            }
            
            if(millis() > PASS_DBG_TIMEOUT) {
                passDebug = false;              
            }
        }
        
        
//        status.leds = status.debug;
        
        status.ignCh0 = read & IGNCH0_MASK;
        status.ignCh1 = read & IGNCH1_MASK;
        
        
//        status.address = (read & ADD_MASK) >> 12;
        
//        if(status.address == 1){
//            status.address = 2;
//        } else if(status.address == 2){
//            status.address = 1;
//        }

        status.ignSense = read & IGN_CTRL_MASK;
        
        if(isAwake && lastVal != (read & INPUTS_MASK))     // if an input has changed, update the corresponding output
        {
            for(i = 0 ; i < 8 ; i++)
            {
                newVal = (read >> (7-i)) & 0x01;
                
                if(status.out[i].shortDelay == 0)
                {
                
                    if(status.inputs[i] < newVal)
                    {
                        status.out[i].outCmd = 0xFF;
                        status.out[i].blinkOff = 0x00;
                    }
                    
                    if(status.inputs[i] > newVal)
                    {
                        status.out[i].outCmd = 0x00;
                        status.out[i].blinkOff = 0x00;
                    }
                
                }
                
                status.inputs[i] = newVal;
            }
            
            lastVal = read & INPUTS_MASK;
        }
        
//        status.tempEdge = read & TEMP_EDGE_MASK;
        status.tempEdge = TEMP_TRIG_Read();
        
        
        timer_set(&s->timer, 5);
        PT_WAIT_UNTIL(&s->pt, timer_expired(&s->timer));        
        
        
        status.batVolt = vbat_read();
        
//        if((status.batVolt.dec >= 15.6 && status.batVolt.hex < 0xC0) || status.batVolt.dec >= 16.0)
        if(status.batVolt.dec > 15.7)
        {
            is12v_not24 = 0;
        }
        else
        {
            is12v_not24 = 1;
        }
        
        
        status.temp = temp_read();
        

//        if(status.tempEdge)
//        {
        if(status.temp.dec >= SHUTOFF_TEMP)
        {
            overheated = 1;
        }
        else
        {
            overheated = 0;
            overheated2 = 0;
        }
//        }
//        else
//        {
//            overheated = 1;
//        }
        
//        if(status.tempEdge)
//        {
//            overheated2 = 1;
//        }
//        else
//        {
//            overheated2 = 0;
//        }

        
        faults = 0;
        
        for(i = 0; i < 8 ; i++)
        {
            outOn = 0;
            
            timer_set(&s->timer, 10);
            PT_WAIT_UNTIL(&s->pt, timer_expired(&s->timer));
            
            pre_read(i);        // takes ~3ms
            
            if((status.out[i].blinkOff != 0) && (status.out[i].outCmd != 0))
            {
                j = 0;
                
                while(status.out[i].output == 0)                // if blink mode, wait for output to be on
                {
                    j++;
                    
                    timer_set(&s->timer, 1);
                    PT_WAIT_UNTIL(&s->pt, timer_expired(&s->timer));
                    
                    if(j > 2500)
                    {
                        continue;
                    }
                }
                
                outOn = 1;
            }
        
            timer_set(&s->timer, 10);
            PT_WAIT_UNTIL(&s->pt, timer_expired(&s->timer));
            
            
            localCur = out_current(i);      // read current
            
            
            if((outOn == 1) && (status.out[i].output == 0))     // check blink didn't turn off while reading
            {
//                myPrintf("cont \n");
                
                i--;
                continue;
            }
            
           
            if(status.out[i].blinkOff == 0 && ((status.out[i].outCmd == 0) || (status.out[i].outCmd == 0xFF))) // std (not blink)
            {
                
                if((offTimer[i] == 0) || (millis() - offTimer[i] > 6000))
                {
                    avgF = 3;
                }
                else
                {
                    if(localCur.dec > 0.5)                  // filter out back emf fault
                    {
                        avgF = 100;
                    }
                    else
                    {
                        avgF = 3;
                    }
                }
//                avgCurrentsDec[i] = approxRollingAverage(avgCurrentsDec[i], localCur.dec, 3);
//                avgCurrentsHex[i] = approxRollingAverage(avgCurrentsHex[i], localCur.hex, 3);
//                status.out[i].current.dec = avgCurrentsDec[i];
//                status.out[i].current.hex = avgCurrentsHex[i];
            }
            else    // non-standard: flash, strobe, pwm
            {
                if(status.out[i].outCmd != 0)
                { 
                    if(status.out[i].outCmd < 0x80)         // ignore short protection on pwm < %50
                    {
                        localCur.dec = 0;
                    }
                    
                    if(status.out[i].outCmd < 0xFE)         // scale pwm currents
                    {
                        localCur.hex = approxRollingAverage((localCur.hex * status.out[i].outCmd / 0xFF), localCur.hex, 5);
                    }
                    
                    if(status.out[i].blinkOff != 0)         // scale blink mode currents
                    {
                        if(status.out[i].blinkOff / status.out[i].blinkOn == 4){
                            localCur.hex = localCur.hex / 4;
                        }else{
                            localCur.hex = localCur.hex / 2;
                        }
                    }
                    
                    
                    if(localCur.dec > 0.5)                  // filter out transient
                    {
                        avgF = 3;
                    }
                    else
                    {
                        avgF = 50;
                    }
                }
                else
                {
                    avgF = 3;
                }
                
            }
            
            avgCurrentsDec[i] = approxRollingAverage(avgCurrentsDec[i], localCur.dec, avgF);
            avgCurrentsHex[i] = approxRollingAverage(avgCurrentsHex[i], localCur.hex, avgF);
            status.out[i].current.dec = avgCurrentsDec[i];
            status.out[i].current.hex = avgCurrentsHex[i];
            
            if(status.pro.isEnabled)
            {
                if(localCur.dec <= 80.0)
                {
                    proShortTimer[i] = millis();
                }
                else if(millis() - proShortTimer[i] > 5000)
                {
                    myPrintf("PRO Fault/Short on SW%d: %f \n", i, fl(localCur.dec));
                    
                    status.out[i].outCmd = 0;
                    status.out[i].blinkOff = 0;
                    status.out[i].open = OUTPUT_SHORT;
                
                }
                
            }
            else
            {
    //            if((approxRollingAverage(localCur.dec, avgCurrentsDec[i], 2) > 70) || 
    //                ((status.out[i].blinkOff == 0 && status.out[i].outCmd >= 0xFE) && 
    //                    ((offTimer[i] == 0) || (millis() - offTimer[i] > 1000)) &&
    //                    (approxRollingAverage(avgCurrentsDec[i], localCur.dec, 3) > 40))){
                if((approxRollingAverage(localCur.dec, avgCurrentsDec[i], 2) > 70) || 
                    ((status.out[i].blinkOff == 0 && status.out[i].outCmd >= 0xFE) && 
                        ((offTimer[i] == 0) || (millis() - offTimer[i] > 2000)) &&
                        (approxRollingAverage(avgCurrentsDec[i], localCur.dec, 4) > 45))){
                    
                    myPrintf("Fault/Short on SW%d: %f \n", i, fl(localCur.dec));
                    
                    status.out[i].outCmd = 0;
    //                status.out[i].output = 0;
    //                status.out[i].blinkOn = 0xff;
                    status.out[i].blinkOff = 0;
                    status.out[i].open = OUTPUT_SHORT;
                    
                    offTimer[i] = 0;
                    
                    status.out[i].shortDelay = millis();

                }
                else if((status.out[i].shortDelay != 0) && (millis() - status.out[i].shortDelay > 3500))
                {
                    status.out[i].shortDelay = 0;
                }
            }
            
            
            
            if(status.out[i].current.dec < 0.05) // Check open/short conditions
            {          
                status.out[i].current.hex = 0;
                status.out[i].current.dec = 0;
                
                if(status.out[i].outCmd) 
                {
                    if(!status.out[i].shortDelay)
                    status.out[i].open = OUTPUT_OPEN;      // no current & powered
                } 
                else 
                {
                    if(!status.out[i].shortDelay)
                    status.out[i].open = OUTPUT_OFF;     // not powered
                }
            } 
            else if(status.out[i].outCmd) 
            {
                if(status.out[i].blinkOff != 0 && status.out[i].blinkOn != 0)// check if strobe or flash
                {
                    if(!status.out[i].shortDelay)
                    status.out[i].open = OUTPUT_FLASH;
                }
                else
                {
                    if(status.out[i].current.dec > 35.0 && status.out[i].outCmd > 200) // short
                    {
//                        status.out[i].open = OUTPUT_SHORT;         // over current
                        
                        myPrintf("Over current on SW%d \n", i);
                        
//                        status.out[i].outCmd = 0;
////                        status.out[i].output = 0;
////                        status.out[i].blinkOn = 0;
//                        status.out[i].blinkOff = 0;
                    }
                    else // nominal
                    {
                      if(!status.out[i].shortDelay)
                      status.out[i].open = OUTPUT_NOM;           // nominal operation  
                    }
                }
            } 
            else // fault
            {
                if(!status.out[i].shortDelay)
                status.out[i].open = OUTPUT_FAULT;
                
                faults++;
                
//                myPrintf("Fault on SW%d \n", i);
                
//                status.out[i].outCmd = 0;
////                status.out[i].output = 0;
////                status.out[i].blinkOn = 0;
//                status.out[i].blinkOff = 0;
                
                //fault_handler(i);  //i, status.out[i].current.hex))

                
                
            }  
        }
        
        
        if(faults > 2){
            adc_c_calibrate();
            faults = 0;
        }
        
    }
    PT_END(&s->pt);
}

bool ignFlag0 = 0;
bool ignFlag1 = 0;

