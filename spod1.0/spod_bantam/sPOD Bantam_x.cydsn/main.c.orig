    isr_canint_StartEx(CANRX_ISR);
    
    CyGlobalIntEnable; 
    
    
    CyBle_Start( StackEventHandler );
    
    srand(ADC_GetResult16(TEMP_CHAN) + 1);
    
    readProFlash();
    
    if(readPasskey() == 0) {
        generatePasskey();
    }
    
