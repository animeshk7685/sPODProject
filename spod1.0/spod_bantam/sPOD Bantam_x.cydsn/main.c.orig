{
    if((status.out[i].blinkOff != 0) && (status.out[i].blinkOn != 0))   // if any blink mode
    {
//        if((millis() - status.out[i].timer) <= (status.out[i].blinkOn))
//        {
//            status.out[i].output = status.out[i].outCmd;
//        }
